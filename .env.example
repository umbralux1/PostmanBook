# Скопируйте в .env и поправьте под себя. Все переменные — с префиксом TRAINER_.

# База — файл SQLite. Локально — рядом с проектом; в Docker — /srv/data/trainer.db.
TRAINER_DATABASE_URL=sqlite:///./trainer.db

# Применять миграции Alembic при старте (удобно в dev). В Docker — false: там миграции
# запускаются отдельной командой перед стартом.
TRAINER_AUTO_CREATE_TABLES=true

# Публичный адрес сайта (для подсказок в фазе 2)
TRAINER_PUBLIC_BASE_URL=http://localhost:8000

# CORS: JSON-список доменов. "*" открывает учебный API для любых сайтов.
TRAINER_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","*"]

# Rate limiting на /api/echo, /api/status и /api/tasks/*
TRAINER_RATE_LIMIT=60/minute
TRAINER_RATE_LIMIT_ENABLED=true

# В prod за HTTPS — true
TRAINER_COOKIE_SECURE=false
TRAINER_DEBUG=false

# На хостинге с постоянным диском (Render и т. п.) — true, чтобы не было предупреждения.
# TRAINER_PERSISTENT_DISK=true
